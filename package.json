{
  "name": "git-commit-test-graph",
  "version": "0.11.0",
  "description": "Deterministic semantic Git repository graph, test graph, and change-impact engine",
  "type": "module",
  "main": "./dist/public/index.js",
  "types": "./dist/public/index.d.ts",
  "exports": {
    ".": "./dist/public/index.js",
    "./api": "./dist/public/index.js",
    "./package.json": "./package.json"
  },
  "bin": {
    "gctg": "bin/gctg.mjs",
    "gctg-mcp": "bin/gctg-mcp.mjs"
  },
  "files": [
    "dist",
    "bin"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "node --test --test-concurrency=1 tests/**/*.test.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "contract:check": "npm run build && node --test tests/contracts/**/*.test.mjs",
    "m04:gate": "node scripts/m04-quality-gate.mjs",
    "check": "npm run typecheck && npm run build && npm test && npm run contract:check",
    "release:check": "node scripts/release-check.mjs",
    "performance:gate": "npm run build && node scripts/performance-gate.mjs",
    "reliability:gate": "node scripts/reliability-gate.mjs",
    "configuration:gate": "node scripts/configuration-gate.mjs",
    "security:gate": "node scripts/security-gate.mjs",
    "compatibility:gate": "npm run build && node scripts/compatibility-gate.mjs",
    "reliability": "node scripts/reliability-gate.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lebavuongquyen/gitcommttestgraph.git"
  },
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/server": "^2.3.1",
    "typescript": "^5.9.3",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^24.8.0"
  }
}
